# ============================================================================
# SubForge Universal AI Backend — Configuration (.env)
# ============================================================================
# Default mode is FREE_ZERO_COST ($0.00/mo using Google AI Studio Free Tier
# + Modal $30/mo Free Serverless GPU Credits + optional Groq/ElevenLabs/Sarvam free tiers)
PROVIDER_PROFILE=FREE_ZERO_COST

# 1. Google AI Studio Free Tier Key (https://aistudio.google.com/apikey — No Card Required!)
# Powers: 1M-Context Story Bible, Direct X->Y 100+ Lang Translation, Multimodal Audio & Contact-Sheet Vision OCR
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Set true on Free Tier (paces requests safely within 10 RPM); set false on Paid Tier 1 (1,000 RPM parallel)
GEMINI_FREE_TIER_PACING=true

# 2. Optional Free/Paid Specialist Speech-to-Text Keys (Auto-routed when present)
GROQ_API_KEY=
ELEVENLABS_API_KEY=
SONIOX_API_KEY=
SARVAM_API_KEY=

# 3. Optional Additional Translation Engines (Paid Pro Scale)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# 4. Local / Modal Open-Source GPU Model Toggles (Used automatically on Modal GPU worker)
ENABLE_LOCAL_DEMUCS=false
ENABLE_LOCAL_WHISPERX=false
ENABLE_LOCAL_NLLB=false
